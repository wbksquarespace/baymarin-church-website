rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function publisher(){return signedIn() && exists(/databases/$(database)/documents/media_publishers/$(request.auth.uid)) && get(/databases/$(database)/documents/media_publishers/$(request.auth.uid)).data.active == true;}
  match /media_publishers/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list,create,update,delete: if false;
  }
  match /sermons/{id} {
   allow get: if resource.data.published == true || publisher();
   allow list: if resource.data.published == true;
   allow create,update,delete: if false; // Only the verified Admin function publishes.
  }
  match /visitor_reminders/{id} {allow read,write: if false;}
  match /{document=**} {allow read,write: if false;}
 }
}
