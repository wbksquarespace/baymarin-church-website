rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function authorized(){
   return request.auth != null && firestore.exists(/databases/(default)/documents/media_publishers/$(request.auth.uid))
    && firestore.get(/databases/(default)/documents/media_publishers/$(request.auth.uid)).data.active == true;
  }
  match /sermons/{uid}/{sermonId}/{filename} {
   allow read: if (authorized() && request.auth.uid == uid)
     || (firestore.exists(/databases/(default)/documents/sermons/$(sermonId))
       && firestore.get(/databases/(default)/documents/sermons/$(sermonId)).data.published == true);
   allow create: if authorized() && request.auth.uid == uid
     && filename.matches('^(message\\.(mp3|m4a)|artwork\\.(jpg|jpeg|png|webp)|seriesArtwork\\.(jpg|jpeg|png|webp)|notes\\.(pdf|docx|txt)|slides\\.(pdf|pptx)|transcript\\.(pdf|txt)|photo[123]\\.(jpg|jpeg|png|webp))$')
     && request.resource.size < 262144000
     && ((filename.matches('^message\\.(mp3|m4a)$') && request.resource.contentType.matches('^(audio/mpeg|audio/mp3|audio/mp4|audio/x-m4a)$'))
       || (filename.matches('^(artwork|seriesArtwork|photo[123])\\.(jpg|jpeg|png|webp)$') && request.resource.size < 12582912 && request.resource.contentType.matches('^image/(jpeg|png|webp)$'))
       || (filename.matches('^notes\\.(pdf|docx|txt)$') && request.resource.size < 15728640 && request.resource.contentType.matches('^(application/pdf|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain)$'))
       || (filename.matches('^slides\\.(pdf|pptx)$') && request.resource.size < 52428800 && request.resource.contentType.matches('^(application/pdf|application/vnd.openxmlformats-officedocument.presentationml.presentation)$'))
       || (filename.matches('^transcript\\.(pdf|txt)$') && request.resource.size < 15728640 && request.resource.contentType.matches('^(application/pdf|text/plain)$')));
   allow update,delete: if false;
  }
  match /{allPaths=**} {allow read,write: if false;}
 }
}
