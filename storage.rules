rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function authorized(){
   return request.auth != null && firestore.exists(/databases/(default)/documents/media_publishers/$(request.auth.uid))
    && firestore.get(/databases/(default)/documents/media_publishers/$(request.auth.uid)).data.active == true;
  }
  match /sermons/{uid}/{sermonId}/{filename} {
   allow read: if true;
   allow create: if authorized() && request.auth.uid == uid
     && filename.matches('^(message\\.(mp3|m4a)|artwork\\.(jpg|jpeg|png|webp))$')
     && request.resource.size < 262144000
     && ((filename.matches('^message\\.(mp3|m4a)$') && request.resource.contentType.matches('^audio/.*$'))
       || (filename.matches('^artwork\\.(jpg|jpeg|png|webp)$') && request.resource.size < 12582912 && request.resource.contentType.matches('^image/.*$')));
   allow update,delete: if false;
  }
  match /{allPaths=**} {allow read,write: if false;}
 }
}
